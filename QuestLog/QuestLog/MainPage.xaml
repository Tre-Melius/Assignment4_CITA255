<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:QuestLog"
             x:Class="QuestLog.MainPage"
             Title="Quest Log">

    <Grid RowDefinitions="Auto,Auto,*,Auto, Auto, Auto, Auto, Auto"
          ColumnDefinitions="*, Auto"
          Padding="24"
          RowSpacing="14">

        <Label Grid.Row="0"
               Text="Quest Log"
               FontSize="30"
               FontAttributes="Bold" />

        <Label Grid.Row="1"
               x:Name="CountLabel"
               Text="0 quests"
               FontSize="14"
               TextColor="Gray" />

        <Border Grid.Row="2" Stroke="LightGray" StrokeThickness="1" Padding="4">

            <!-- =================================================================
                 TODO 4

                 Add the attribute to the CollectionView below:

                 "Quests" is a STRING here. The compiler never checks it, so a
                 typo gives you an empty list and no error at all. It has to
                 match the property name in the code-behind exactly.
                 ================================================================= -->
            <CollectionView x:Name="QuestView" ItemsSource="{Binding Quests}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <local:QuestCard />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No quests yet."
                           FontSize="16" 
                           TextColor="Gray"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>

            </CollectionView>
        </Border>
        
        <Entry Grid.Row="3"
               x:Name="NewQuestEntry"
               Placeholder="Enter a new quest" />
        <Entry Grid.Row="4"
               x:Name="NewQuestGiverEntry"
               Placeholder="Enter the quest giver" />
        <Entry Grid.Row="5"
               Keyboard="Numeric"
               x:Name="QuestRewardEntry"
               Placeholder="Enter the quest reward" />

        <Button Grid.Row="6"
                Text="Accept a quest"
                Clicked="OnAddClicked" />
        <Button Grid.Row="7"
                Text="Turn in quest"
                Clicked="OnTurnInQuestClicked" />

    </Grid>
</ContentPage>
